<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BleLink" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Compact utility buttons (fullscreen toggles, "View", "Cast & speakers") — outlined to
         match the app's card style (cream surface + dark outline) instead of Material3's
         TonalButton, which pulls an undefined secondary-container color that renders as a
         dark navy/purple clashing with the rest of the light, warm palette. -->
    <style name="Widget.BleLink.Button.Utility" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="android:textColor">@color/on_background</item>
        <item name="iconTint">@color/on_background</item>
        <item name="rippleColor">@color/outline</item>
    </style>
</resources>
