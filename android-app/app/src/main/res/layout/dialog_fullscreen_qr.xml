<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/background"
    android:padding="24dp">

    <ImageView
        android:id="@+id/fullscreenQrImageBluetooth"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:contentDescription="@string/scan_to_join" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/join_label_bluetooth"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="@color/on_surface_variant" />

    <ImageView
        android:id="@+id/fullscreenQrImageWifi"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginTop="28dp"
        android:contentDescription="@string/scan_to_join_lan" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/join_label_wifi"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="@color/on_surface_variant" />

</LinearLayout>
